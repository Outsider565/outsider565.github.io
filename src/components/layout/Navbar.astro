---
import { NAV_LINKS } from "../../config";

const currentPath = Astro.url.pathname;
const links = NAV_LINKS.filter((link) => link.isActive);
---

<nav class="navbar">
    <ul class="nav-links">
        {
            links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        class={`nav-link ${
                            currentPath === link.href ||
                            (link.href !== "/" &&
                                currentPath.startsWith(`${link.href}/`))
                                ? "active"
                                : "inactive"
                        }`}
                    >
                        {link.label}
                        <span class="nav-link-line" />
                    </a>
                </li>
            ))
        }
    </ul>
</nav>
