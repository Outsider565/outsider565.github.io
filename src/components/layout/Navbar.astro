---
import { getLangFromPath, navLinks, stripLang, switchLangPath, UI, type Lang } from "../../utils/i18n";

const currentPath = Astro.url.pathname;
const lang = getLangFromPath(currentPath);
const targetLang: Lang = lang === "en" ? "zh" : "en";
const links = navLinks(lang);
const strippedPath = stripLang(currentPath);
---

<nav class="navbar">
    <ul class="nav-links">
        {
            links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        class={`nav-link ${
                            strippedPath === stripLang(link.href) ||
                            (stripLang(link.href) !== "/" &&
                                strippedPath.startsWith(stripLang(link.href)))
                                ? "active"
                                : "inactive"
                        }`}
                    >
                        {link.label}
                        <span class="nav-link-line" />
                    </a>
                </li>
            ))
        }
    </ul>
    <a class="language-switch" href={switchLangPath(currentPath, targetLang)} aria-label={`Switch to ${UI[targetLang].languageName}`}>
        {UI[lang].languageSwitch}
    </a>
</nav>
