---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { UI } from "../../config/ui";

const copy = UI.pages.misc;
const miscEntry = await getEntry("misc", "en");
const { Content: MiscContent } = miscEntry
    ? await render(miscEntry)
    : { Content: null };
---

<BaseLayout title={copy.title}>
    <div class="container-narrow">
        <header class="page-header">
            <h1 class="page-title">{copy.title}</h1>
        </header>
        <div class="prose">
            {MiscContent ? <MiscContent /> : <p>Loading misc...</p>}
        </div>
    </div>
</BaseLayout>
